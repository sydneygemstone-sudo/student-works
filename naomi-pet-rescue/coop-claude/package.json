{
  "name": "naomi-pet-rescue-coop-claude",
  "version": "1.0.0",
  "private": true,
  "description": "Naomi《小动物回家》双 iPad 局域网联机 3D 探索版（共同回合制 + Three.js 越肩视角 + 东北角树篱迷宫）",
  "author": "Claude Code (Claude Opus)",
  "license": "MIT",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "qr": "node -e \"import('./server/net.js').then(async m=>{const{url}=m.buildLanUrl(process.env.PORT||8791);const q=await import('qrcode');console.log(await q.default.toString(url,{type:'terminal',small:true}));console.log(url);})\""
  },
  "keywords": [
    "naomi",
    "coop",
    "turn-based",
    "three.js",
    "lan",
    "websocket",
    "ipad"
  ],
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.169.0",
    "ws": "^8.18.0"
  }
}
